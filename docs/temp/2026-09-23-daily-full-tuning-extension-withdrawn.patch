+    from training.registry import features
+
+    params = node.get("params")
+    winsorize = params.get("winsorize") if isinstance(params, dict) else None
+    if not isinstance(winsorize, list) or not winsorize:
+        return []
+    total = 0
+    for ref in input_refs(node):
+        target = nodes.get(ref.node)
+        if target is None:
+            return []
+        if target["type"] == "feature":
+            width = features.feature_output_width(target.get("key"), target.get("params"))
+        elif target["type"] == "model":
+            spec = model_specs.get(ref.node, {}).get(ref.output)
+            width = spec.get("columns") if isinstance(spec, dict) else None
+        else:
+            return []
+        if width is None:
+            return []
+        total += width
+    issues = []
+    for i, item in enumerate(winsorize):
+        col = item.get("column") if isinstance(item, dict) else None
+        if _int_at_least(col, 0) and int(col) < total:
+            continue
+        if _int_at_least(col, 0):
+            issues.append(
