+def _winsorize_column_issues(nid: str, node: dict, nodes: dict, model_specs: dict) -> list[str]:
+    """params.winsorize 的 column 索引是否落在這個節點串接後的實際總欄數內；只在能靜態算出
+    全部輸入寬度時才檢查（任何一段算不出來——例如 quant_saved_strategy、或引用了不存在的
