+@register("lagged_return_cum")
+def lagged_return_cum(df, params: dict | None = None) -> np.ndarray:
+    """N 期累積報酬（look-back，只用 t 及更早的資料，不是 Label 用的未來報酬）：
+    log(close[t] / close[t-n])——t 這根棒相對「n 根棒之前」的對數報酬。
+    跟 outcomes.py 的 log_return 公式相同、方向相反（那裡是 close[t+h] 相對 close[t]，這裡是
+    close[t] 相對 close[t-n]）——刻意不共用同一個函式，兩處語意不同，共用容易在改動時搞混方向。
+    params: {"n": 往回看幾根棒，預設 1，必須是 >= 1 的整數}。
+    """
+    n = (params or {}).get("n", 1)
+    if not _is_int_at_least(n, 1):
+        raise ValueError("lagged_return_cum 的 params.n 必須是 >= 1 的整數")
+    n = int(n)
+    close = df["close"].to_numpy(dtype=float)
+    out = np.full(len(close), np.nan)
+    if n < len(close):
+        out[n:] = np.log(close[n:] / close[:-n])
+    return _as_2d(out)
+
+
+@register("lagged_return")
+def lagged_return(df, params: dict | None = None) -> np.ndarray:
+    """單期對數報酬 r[t] = log(close[t]/close[t-1]) 向後位移 n 期：輸出 r[t-n]，不是 t 這根棒
+    自己的單期報酬（n=0 才是）。跟 lagged_return_cum（N 期累積報酬）不同：n=1 時兩者恰好相同，
+    n>1 時 lagged_return 仍然是「單期」報酬（只差一根棒），lagged_return_cum 是「N 根棒的
+    累積」報酬——這是研究草案要求刻意區分的兩種特徵，不能互相取代。
+    params: {"n": 位移幾根棒，預設 1，必須是 >= 0 的整數；0 等於 t 這根棒自己的單期報酬}。
+    """
+    n = (params or {}).get("n", 1)
+    if not _is_int_at_least(n, 0):
+        raise ValueError("lagged_return 的 params.n 必須是 >= 0 的整數")
+    n = int(n)
+    close = df["close"].to_numpy(dtype=float)
+    r1 = np.full(len(close), np.nan)
+    if len(close) > 1:
+        r1[1:] = np.log(close[1:] / close[:-1])
+    if n == 0:
+        out = r1
+    else:
+        out = np.full(len(close), np.nan)
+        if n < len(close):
+            out[n:] = r1[:-n]
+    return _as_2d(out)
+
+
+@register("rolling_return_std")
+def rolling_return_std(df, params: dict | None = None) -> np.ndarray:
+    """單期對數報酬 r[t] = log(close[t]/close[t-return_period]) 的滾動標準差，只用 t 及更早的資料。
+    params（皆需在提交前就明確給定，避免研究端跟平台對「報酬定義」或「樣本/母體標準差」有預設落差）：
+      "return_period"：算報酬用幾根棒的差，預設 1；
+      "window"：滾動視窗長度（必填，多少根報酬取一次標準差）；
+      "ddof"：0（母體標準差，NumPy／pandas 預設）或 1（樣本標準差），預設 0；
+      "min_periods"：視窗內至少要有幾筆報酬才算，預設等於 window（湊不滿一律 NaN，
+        不用比視窗長度短的資料算出可能失真的標準差）。
+    """
+    import pandas as pd
+
+    p = params or {}
+    if "window" not in p:
+        raise ValueError("rolling_return_std 缺少 params.window")
+    window, return_period = p["window"], p.get("return_period", 1)
+    ddof, min_periods = p.get("ddof", 0), p.get("min_periods", p["window"])
+    if not (_is_int_at_least(window, 1) and _is_int_at_least(return_period, 1) and _is_int_at_least(min_periods, 1)):
+        raise ValueError("rolling_return_std 的 window／return_period／min_periods 必須是 >= 1 的整數")
+    if ddof not in (0, 1):
+        raise ValueError("rolling_return_std 的 params.ddof 必須是 0 或 1")
+    window, return_period, min_periods = int(window), int(return_period), int(min_periods)
+    close = df["close"].to_numpy(dtype=float)
+    r = np.full(len(close), np.nan)
+    if return_period < len(close):
+        r[return_period:] = np.log(close[return_period:] / close[:-return_period])
+    out = pd.Series(r).rolling(window=window, min_periods=min_periods).std(ddof=int(ddof)).to_numpy()
+    return _as_2d(out)
+
+
+CALENDAR_COMPONENTS = ("dow_sin", "dow_cos", "month_sin", "month_cos")
+
+
+@register("calendar")
+def calendar(df, params: dict | None = None) -> np.ndarray:
+    """日期的週期編碼，直接從資料本身的時間索引算，不接任何外部資料源。
+    口徑：用資料庫存的 naive datetime（等同交易所本地時間，訓練/推論全程不做時區轉換）；
+    星期用 weekday()（Mon=0…Sun=6，實務上只會出現 0-4，因為只有交易日有資料）、月份用 1-12
+    算 sin/cos 週期編碼；不做假日或半日市調整（那需要交易日曆，這裡沒有這份資料）。
+    params: {"components": 要輸出哪幾個、依這個順序輸出，預設全部四個（見 CALENDAR_COMPONENTS）}。
+    """
+    comps = (params or {}).get("components") or list(CALENDAR_COMPONENTS)
+    if not isinstance(comps, list) or not comps or any(c not in CALENDAR_COMPONENTS for c in comps):
+        raise ValueError(f"calendar 的 params.components 只能是 {CALENDAR_COMPONENTS} 的非空子集合，收到 {comps!r}")
+    dow = df.index.weekday.to_numpy(dtype=float)
+    month = df.index.month.to_numpy(dtype=float)
+    values = {
+        "dow_sin": np.sin(2 * np.pi * dow / 7), "dow_cos": np.cos(2 * np.pi * dow / 7),
+        "month_sin": np.sin(2 * np.pi * (month - 1) / 12), "month_cos": np.cos(2 * np.pi * (month - 1) / 12),
+    }
+    return np.stack([values[c] for c in comps], axis=1)
+
