+
+    缺欄位不是拿 null 混進每一列資料裡假裝有這欄，是在 `columns_present` 明講這張表本身
+    有沒有這個欄位（整張表一致的 schema 事實）；表沒有的欄位，`rows` 裡直接不會出現那個 key，
+    不用逐列猜「這裡的 null 是本來就沒資料，還是這欄根本不存在」。
+    """
+    table = quotes_table(symbol, timeframe)
+    conn = await asyncpg.connect(QUOTES_DATABASE_URL)
+    try:
+        present = await _existing_columns(conn, table, _METADATA_CANDIDATES)
+        cols = ["datetime"] + [c for c in _METADATA_CANDIDATES if present[c]]
+        rows = await conn.fetch(
+            f"SELECT {', '.join(cols)} FROM {table} WHERE datetime >= $1 AND datetime < $2 "
+            "ORDER BY datetime ASC, built_at ASC",
+            start, end,
+        )
+    finally:
+        await conn.close()
+
+    out_rows = []
+    for r in rows:
+        row = {"datetime": int(r["datetime"].timestamp())}
+        for c in _METADATA_CANDIDATES:
+            if not present[c]:
+                continue
+            v = r[c]
+            row[c] = int(v.timestamp()) if c == "bar_end_ts" and v is not None else v
+        out_rows.append(row)
+    return {"table": table, "columns_present": present, "rows": out_rows}
