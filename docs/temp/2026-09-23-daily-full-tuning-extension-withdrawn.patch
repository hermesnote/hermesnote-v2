+    p = params or {}
+    if key == "lagged_return_cum" and "n" in p and not _is_int_at_least(p["n"], 1):
+        return ["lagged_return_cum 的 params.n 必須是 >= 1 的整數"]
+    if key == "lagged_return" and "n" in p and not _is_int_at_least(p["n"], 0):
+        return ["lagged_return 的 params.n 必須是 >= 0 的整數"]
+    if key == "rolling_return_std":
+        issues = []
+        if "window" not in p:
+            issues.append("rolling_return_std 缺少 params.window")
+        elif not _is_int_at_least(p["window"], 1):
+            issues.append("rolling_return_std 的 params.window 必須是 >= 1 的整數")
+        if "return_period" in p and not _is_int_at_least(p["return_period"], 1):
+            issues.append("rolling_return_std 的 params.return_period 必須是 >= 1 的整數")
+        if "ddof" in p and p["ddof"] not in (0, 1):
+            issues.append("rolling_return_std 的 params.ddof 必須是 0 或 1")
+        if "min_periods" in p and not _is_int_at_least(p["min_periods"], 1):
+            issues.append("rolling_return_std 的 params.min_periods 必須是 >= 1 的整數")
+        return issues
+    if key == "calendar" and "components" in p:
+        comps = p["components"]
+        if not isinstance(comps, list) or not comps or any(c not in CALENDAR_COMPONENTS for c in comps):
+            return [f"calendar 的 params.components 只能是 {CALENDAR_COMPONENTS} 的非空子集合"]
