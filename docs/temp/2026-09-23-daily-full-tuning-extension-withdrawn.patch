+def talib_overridable_field(name: str) -> str | None:
+    """這個 TA-Lib 指標唯一可覆寫的輸入角色名稱（例如 'price'），沒有可覆寫的角色就回 None。
+
+    只有「單一輸入角色、且該角色只對應一個欄位（不是欄位陣列）」的指標才能覆寫輸入欄位——
+    例如 BBANDS／ROC／MOM／MAX／MIN／STDDEV：`input_names == {'price': 'close'}`，這種預設
+    吃 close，可以覆寫成吃 volume（成交量 ROC）或 high／low（通道類指標）。BBANDS 雖然有三個
+    輸出（upperband/middleband/lowerband），但輸入角色只有一個 'price'，一樣可以覆寫。
+    像 ATR／STOCH／AD／ADX／MFI／SAR／AROON／OBV 這種一次固定吃好幾個欄位
+    （`input_names` 有多個角色，或某個角色對應的是欄位陣列，例如 OBV 的
+    `{'price': 'close', 'prices': ['volume']}`）本身角色跟欄位已經綁死，不支援覆寫。
+    官方各函式的輸入角色定義：https://ta-lib.github.io/ta-lib-python/func_groups/ （依 func group 分頁）。
+    """
+    names = _talib_function(name).input_names
+    if len(names) != 1:
