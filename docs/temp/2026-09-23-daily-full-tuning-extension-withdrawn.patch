+async def _existing_columns(conn, table: str, candidates: list[str]) -> dict[str, bool]:
+    """這張表實際有哪些候選欄位（schema 層級、對整張表一致，不是逐列判斷）。
+    表名已過 quotes_table 白名單；這裡再把 schema／表名拆開用參數綁定查 information_schema，
+    不是把整個表名字串塞進條件式。"""
+    schema, _, name = table.partition(".")
+    rows = await conn.fetch(
+        "SELECT column_name FROM information_schema.columns WHERE table_schema = $1 AND table_name = $2 "
+        "AND column_name = ANY($3)",
+        schema, name, candidates,
+    )
+    present = {r["column_name"] for r in rows}
+    return {c: c in present for c in candidates}
+
+
+# 唯讀稽核用的候選欄位：資訊可用時間（bar_end_ts）與合約／換月證據（contract_month／
+# rule_version／contract_rank，contract_rank 只有 contract_* 這種一天多列的合約表才有）。
+_METADATA_CANDIDATES = ["bar_end_ts", "contract_month", "rule_version", "contract_rank"]
+
+
