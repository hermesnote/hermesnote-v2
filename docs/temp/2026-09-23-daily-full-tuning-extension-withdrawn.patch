+def feature_output_width(key: str, params) -> int | None:
+    """這個 Feature 節點（依 key＋params）輸出的欄數，只依 metadata／固定規則算，不吃資料；
+    算不出來（例如 quant_saved_strategy 要查 DB 才知道有幾棵樹）回 None——呼叫端（欄位邊界
+    的提交前驗證）遇到 None 要放棄靜態檢查，不能當作 0 或任何猜測值。
+    """
+    p = params if isinstance(params, dict) else {}
+    if key == "ohlcv":
+        return 5
+    if key == "raw_price":
+        return 4
+    if key == "raw_volume":
+        return 1
+    if key in ("lagged_return_cum", "lagged_return", "rolling_return_std"):
+        return 1
+    if key == "calendar":
+        comps = p.get("components") or list(CALENDAR_COMPONENTS)
+        return len(comps) if isinstance(comps, list) else None
